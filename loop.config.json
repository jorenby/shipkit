{
  "ship_root": ".",
  "repos": [],
  "max_concurrent_crew": 2,
  "github_org": "YourOrg",
  "chat_surface": {
    "kind": "file",
    "path": "inbox/captain.md"
  },
  "validator_cmd": null,
  "agents": {
    "install_target": "~/.claude/agents",
    "defs": ["ship-mate", "ship-bosun", "ship-crew", "ship-lookout", "ship-reviewer", "ship-pilot"]
  },
  "hooks": {
    "mate_bash": "modules/autonomous/hooks/validate-mate-bash.sh",
    "mate_mcp": "modules/autonomous/hooks/validate-mate-mcp.sh",
    "bosun_bash": "modules/autonomous/hooks/validate-bosun-bash.sh",
    "crew_bash": "core/hooks/validate-crew-bash.sh",
    "readonly_bash": "core/hooks/validate-readonly-bash.sh"
  },
  "launch": {
    "mate_prompt": "/ship-watch-start",
    "bosun_prompt": "/loop",
    "sandbox_wrapper": "~/.config/sandbox-exec/run-sandboxed.sh",
    "mate_mcp_config": "~/.config/ship/mate-mcp.json",
    "bosun_mcp_config": "~/.config/ship/bosun-mcp.json"
  },
  "headroom_signal_path": null,
  "hosts_ports": null
}
